# Copy to deploy/.env (ignored by Git) and replace placeholders before startup.
POSTGRES_DB=bizflow
POSTGRES_USER=bizflow
POSTGRES_PASSWORD=replace-with-a-unique-local-secret
# Change POSTGRES_PORT to 5433 or another port if port 5432 is already in use by local PostgreSQL
POSTGRES_PORT=5432

# Host-run API configuration. Do not put real values in this file.
# ConnectionStrings__BizFlow=Host=localhost;Port=5432;Database=bizflow;Username=bizflow;Password=YOUR_LOCAL_SECRET
# Jwt__SigningKeyBase64=BASE64_ENCODED_RANDOM_KEY_OF_AT_LEAST_32_BYTES
# Jwt__Issuer=BizFlow
# Jwt__Audience=BizFlow.Web

# Optional API/frontend container overlay. Connection string must use the postgres service host
# and match POSTGRES_DB/USER/PASSWORD above. Quote/escape password per Npgsql connection-string rules.
BIZFLOW_DATABASE_CONNECTION=Host=postgres;Database=bizflow;Username=bizflow;Password=replace-with-a-unique-local-secret;GSS Encryption Mode=Disable
JWT_SIGNING_KEY_BASE64=replace-with-a-base64-encoded-random-key
JWT_ISSUER=BizFlow
JWT_AUDIENCE=BizFlow.Web
WEB_PORT=8080

# Recovery remains disabled in the demo overlay. See docs/02-traceability/password-reset-slice.md
# for TLS SMTP settings when enabling it in an operator-owned deployment override.

# Future provider configuration; model selection remains deployment-specific.
# OpenAI__ApiKey=
# OpenAI__Model=
# Storage__Endpoint=
# Storage__AccessKey=
# Storage__SecretKey=
# Storage__Bucket=bizflow-evidence
